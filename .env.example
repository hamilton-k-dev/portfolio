# Optional — enables the "Ask Hamilton AI" chatbot.
OPENROUTER_API_KEY=

# ---- Contact form ----------------------------------------------------------
# Without these two, /api/contact answers 503 and the form shows a real failure
# with a mailto fallback. It never pretends to have sent anything.
#
# RESEND_API_KEY   from resend.com — the free tier covers a portfolio
# CONTACT_TO       where enquiries land
RESEND_API_KEY=
CONTACT_TO=hamiltonkenfack@gmail.com

# Optional. The default sender works with no domain setup, but Resend only
# delivers it to the address that owns the account — which is exactly what a
# contact form needs. Set this once you have verified your own domain.
# CONTACT_FROM="Portfolio <hello@yourdomain.dev>"
